# iOS app identity. Values are env-driven so no account data is committed;
# the production bundle id and current team id are safe, non-secret defaults.
# Fill the ASC_* / APPLE_* env vars once a paid Apple Developer Program
# membership is active. See docs/ci/IOS_TESTFLIGHT.md.
app_identifier(ENV["ASC_APP_IDENTIFIER"] || "sa.dwelleo.app")
apple_id(ENV["ASC_APPLE_ID"])                       # Apple Developer account email
team_id(ENV["APPLE_TEAM_ID"] || "Z28762D2MN")       # Developer Portal team id
itc_team_id(ENV["ASC_TEAM_ID"])                     # App Store Connect team id (optional with API key)
