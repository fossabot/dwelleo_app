default_platform(:ios)

# iOS release automation → TestFlight.
#
# DORMANT until a PAID Apple Developer Program membership is active. TestFlight
# — and every form of iOS over-the-air distribution — is gated behind the paid
# program; with a free Apple ID only local 7-day development builds are possible
# (`flutter run --flavor dev -t lib/main_dev.dart`). The full "day you go paid"
# checklist is in docs/ci/IOS_TESTFLIGHT.md.
#
# Run locally from repo root once the account + env are ready:
#   cd ios && bundle exec fastlane ios beta

REPO_ROOT = File.expand_path("../..", __dir__)

# Bundle id shipped to TestFlight — the production flavor (App Store target).
APP_IDENTIFIER = "sa.dwelleo.app"

def head_release_notes
  subject = `git -C #{REPO_ROOT} log -1 --pretty=%s`.strip
  sha     = `git -C #{REPO_ROOT} log -1 --pretty=%h`.strip
  return "Internal build via Fastlane." unless $?.success? && !subject.empty?

  "#{subject} (#{sha})"
end

# App Store Connect API key from env (App Store Connect → Users and Access →
# Integrations → App Store Connect API). Pass the .p8 as raw contents
# (ASC_KEY_P8) or a file path (ASC_KEY_P8_PATH). Fails early with a clear
# message while the pipeline is dormant, instead of a cryptic signing error.
def ensure_asc_api_key
  key_id    = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  key_p8    = ENV["ASC_KEY_P8"].to_s
  key_path  = ENV["ASC_KEY_P8_PATH"].to_s

  if key_id.empty? || issuer_id.empty? || (key_p8.empty? && key_path.empty?)
    UI.user_error!(
      "iOS TestFlight is dormant. Activate a paid Apple Developer Program " \
      "membership, then set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8 " \
      "(or ASC_KEY_P8_PATH). See docs/ci/IOS_TESTFLIGHT.md."
    )
  end

  # If ASC_KEY_P8 is stored base64-encoded in GitHub Secrets (matching the
  # project convention for all other secrets), set is_key_content_base64: true.
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_p8.empty? ? nil : key_p8,
    key_filepath: key_path.empty? ? nil : key_path,
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  desc "Build the production IPA and upload it to TestFlight (internal testers)"
  lane :beta do
    api_key = ensure_asc_api_key

    # Flutter-native archive: builds Runner.xcworkspace for the production
    # flavor and exports a signed App Store IPA under build/ios/ipa/.
    sh("cd #{REPO_ROOT} && flutter build ipa " \
       "--flavor production -t lib/main_production.dart --release " \
       "--export-method app-store")

    ipa = Dir[File.join(REPO_ROOT, "build", "ios", "ipa", "*.ipa")]
          .max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA produced under build/ios/ipa.") if ipa.nil?

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      distribute_external: false,            # internal testers get it instantly
      changelog: head_release_notes,
      skip_waiting_for_build_processing: true
    )
  end
end
