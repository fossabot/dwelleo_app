.env
.env.*
!.env.example
.dart-defines
*.dartdefines
dart_defines/

# Android signing
*.jks
*.keystore
key.properties
/android/key.properties

# iOS signing
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

# Xcode/SwiftPM local state and user data (do not ignore shared xcschemes)
ios/Flutter/Secrets.xcconfig
ios/build/
ios/.symlinks/
ios/Pods/
ios/Podfile.lock.backup
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcscheme~
**/*.xcscheme.bak
**/*.xcscheme.backup
**/xcshareddata/swiftpm/configuration/

# Firebase client config supplied per flavor by developers/CI.
# These are client config files, not service accounts, but they require rules,
# App Check, API-key restrictions, and environment review before sharing.
google-services.json
GoogleService-Info.plist
firebase_options*.dart
firebase_app_id_file.json
ios/config/GoogleService-Info-*.plist

# Service accounts & API keys
service-account.json
*-service-account.json
*.pem
secrets.json

# Fastlane local output/configuration
fastlane/Appfile
fastlane/Matchfile
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
