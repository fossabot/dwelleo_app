# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.history
.svn/
migrate_working_dir/

# Editor-local configuration
*.iml
*.ipr
*.iws
.idea/
.vscode/*
!.vscode/launch.json

# Flutter/Dart/Pub generated output
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
devtools_options.yaml

# Symbolication / obfuscation outputs
app.*.symbols
app.*.map.json

# Android build output and local files
/android/.gradle/
/android/build/
/android/app/build/
/android/app/debug
/android/app/profile
/android/app/release
android/local.properties
android/secrets.properties

# ── Secrets & credentials (NEVER commit) ────────────────────────────────────
# Environment files
.env
.env.*
!.env.example
.dart-defines
*.dartdefines
dart_defines/

# Android signing
*.jks
*.keystore
key.properties
/android/key.properties

# iOS signing
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

# Xcode/SwiftPM local state and user data (do not ignore shared xcschemes)
ios/Flutter/Secrets.xcconfig
ios/build/
ios/.symlinks/
ios/Pods/
ios/Podfile.lock.backup
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcscheme~
**/*.xcscheme.bak
**/*.xcscheme.backup
# SwiftPM workspace state — the project builds via CocoaPods, so these
# auto-generated package pins are orphaned artifacts. Ignore all of it.
**/xcshareddata/swiftpm/

# Firebase client config supplied per flavor by developers/CI.
# These are client config files, not service accounts, but they require rules,
# App Check, API-key restrictions, and environment review before sharing.
google-services.json
GoogleService-Info.plist
firebase_options*.dart
firebase_app_id_file.json
ios/config/GoogleService-Info-*.plist

# Service accounts & API keys
service-account.json
*-service-account.json
*.pem
secrets.json
# Firebase service-account credentials (App Distribution / supply). These are
# LIVE credentials — never commit. Injected in CI via base64 GitHub secret and
# referenced locally from a gitignored path.
firebase-service-account*.json
**/dwelleo-*service-account*.json
dwelleo-60f38-*.json
gha-creds-*.json

# Per-flavor --dart-define secret bundles (env/dev.json, env/production.json …).
# Ignore the real files but keep the checked-in templates (env/*.example.json).
# NB: ignore the contents, not the dir itself, so the negation can take effect.
/env/*.json
!/env/*.example.json

# Stray root-level fastlane files — fastlane must be run from android/ or ios/,
# never from the repo root. Ignore any files it creates here if run by mistake.
/fastlane/
/Gemfile
/Gemfile.lock

# Fastlane local output/configuration (match any platform subdir: android/, ios/)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
**/fastlane/Matchfile
**/fastlane/.env
**/fastlane/*.p8
**/fastlane/*.mobileprovision
